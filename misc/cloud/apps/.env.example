# Deployment identity
AWS_ACCOUNT_ID=589026446197
AWS_REGION=sa-east-1
APPS_STACK_NAME=CarsGalore-apps-dev

# Immutable GHCR image location. Build and push this tag before RUN_APPS=true.
GHCR_OWNER=your-github-owner
IMAGE_TAG=sha-your-commit

# Existing CarsGalore-infra-dev outputs
INFRA_VPC_ID=vpc-...
INFRA_PUBLIC_SUBNET_IDS=subnet-...,subnet-...
INFRA_PUBLIC_SUBNET_AZS=sa-east-1a,sa-east-1c
INFRA_PRIVATE_SUBNET_IDS=subnet-...,subnet-...
INFRA_PRIVATE_SUBNET_AZS=sa-east-1a,sa-east-1c
INFRA_APPLICATION_SECURITY_GROUP_ID=sg-...
RDS_ENDPOINT=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432
RDS_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:589026446197:secret:...
COGNITO_USER_POOL_ID=sa-east-1_H59laNeJi
COGNITO_ISSUER_URL=https://cognito-idp.sa-east-1.amazonaws.com/sa-east-1_H59laNeJi

# Private service discovery and single-broker Kafka Native configuration
CLOUD_MAP_NAMESPACE=sub3.local
KAFKA_IMAGE=apache/kafka-native:4.1.2
KAFKA_NODE_ID=1
KAFKA_NUM_PARTITIONS=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Set false for the first CDK deploy. Run `npm run bootstrap-ghcr`, then set true
# and deploy again to start Kafka and the applications.
RUN_APPS=false

# Local-only credentials consumed by `npm run bootstrap-ghcr`; never commit them.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=your-github-token-with-package-read
