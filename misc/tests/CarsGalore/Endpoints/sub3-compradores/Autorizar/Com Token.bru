meta {
  name: Com Token
  type: http
  seq: 2
}

put {
  url: http://{{compradores_service_host}}/autorizar/{{comprador2_cpf}}
  body: none
  auth: inherit
}

script:pre-request {
  req.setHeader(
    "Authorization",
    `Bearer ${bru.getVar("funcionario_bearer_token")}`
  )
}

tests {
  test("deve ser bem sucedido", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
