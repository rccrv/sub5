meta {
  name: Reservar comprador1
  type: http
  seq: 1
}

post {
  url: http://{{orquestrador_url}}/pagamentos/reservas
  body: json
  auth: inherit
}

body:json {
  {
    "placa": "ABC1D23",
    "endereco": "Rua do Comprador 1, 100, São Paulo - SP",
    "cep": "01305-100"
  }
}

script:pre-request {
  req.setHeader(
    "Authorization",
    `Bearer ${bru.getVar("comprador1_bearer_token")}`
  )
}

script:post-response {
  bru.setVar("pix_comprador1", res.body.pixCode)
  bru.setVar("id_comprador1", res.body.id)
}

tests {
  test("deve ser bem sucedido", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
