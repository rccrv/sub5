meta {
  name: Listar
  type: http
  seq: 1
}

get {
  url: http://{{orquestrador_url}}/veiculos/listar-venda
  body: none
  auth: inherit
}

script:pre-request {
  req.setHeader(
    "Authorization",
    `Bearer ${bru.getVar("comprador1_bearer_token")}`
  )
}

tests {
  test("deve ser bem sucedido", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
