meta {
  name: Cadastrar
  type: http
  seq: 1
}

post {
  url: http://{{orquestrador_url}}/veiculos/cadastrar
  body: json
  auth: inherit
}

body:json {
  {
    "marca": "Gurgel",
    "modelo": "BR-800",
    "ano": 1990,
    "placa": "ABC1D23",
    "cor": "Prata",
    "valor": 25000.00
  }
}

script:pre-request {
  req.setHeader(
    "Authorization",
    `Bearer ${bru.getVar("funcionario_bearer_token")}`
  )
}

script:post-response {
  bru.setVar("veiculo1_placa", res.body.placa)
}

tests {
  test("deve ser bem sucedido", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
