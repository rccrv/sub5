meta {
  name: Login (funcionario)
  type: http
  seq: 1
}

post {
  url: https://cognito-idp.sa-east-1.amazonaws.com/
  body: json
  auth: basic
}

headers {
  Content-Type: application/x-amz-json-1.1
  X-Amz-Target: AWSCognitoIdentityProviderService.InitiateAuth
}

auth:basic {
  username: compradores
  password: WiGPbgwfBBwoouEdqnVdtJVsaUG3deb2
}

body:json {
  {
    "AuthFlow": "USER_PASSWORD_AUTH",
    "ClientId": "{{cognito_client_id}}",
    "AuthParameters": {
      "USERNAME": "funcionario",
      "PASSWORD": "funcionario"
    }
  }
}

body:form-urlencoded {
  username: {{comprador2_cpf}}
  password: {{comprador2_cpf}}
  grant_type: password
}

script:post-response {
  bru.setVar("funcionario_bearer_token", res.body.AuthenticationResult.AccessToken)
}

tests {
  test("deve ser bem sucedido", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
